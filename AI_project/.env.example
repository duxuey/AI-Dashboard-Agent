# DeepSeek API 密钥（必填，在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxx

# 使用的模型：deepseek-v4-flash（快/便宜）或 deepseek-v4-pro（强/推理）
DEEPSEEK_MODEL=deepseek-v4-flash

# DeepSeek 兼容端点（OpenAI 协议，一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Web 服务监听地址与端口（可选）
HOST=127.0.0.1
PORT=8000

# ---- 接入的系统（可选）----
# 运行记录按来源系统区分：看板自己新建的任务算 dashboard，
# 外部项目通过 /api/ingest 上报时带自己的 source。
# 格式：key:显示名，逗号分隔（中英文逗号都行）；只按第一个冒号切，
# 所以显示名里可以再带冒号。
#
# dashboard（AI-Dashboard-Agent）和 canvas 是内置项，不写也有显示名；写在这里可以改。
# 接新项目时追加一项，比如：
#   SYSTEMS=billing:保单系统,portal:门户站点
# 改完重启服务生效。
#
# 注意这不是白名单：没登记就上报的 source 照收不误，
# 列表和统计里先用原始 key 显示，补上显示名后自动变中文。
#SYSTEMS=

# ---- 上下文压缩（可选，一般不用改）----
# 对话超过预算时，把较早的部分交给模型做成摘要，用摘要替换原文。
#
# 模型的上下文窗口。deepseek-v4-flash / v4-pro 官方标称 1M：
#   https://api-docs.deepseek.com/zh-cn/news/news260424/
# 换模型时务必改这里。
MODEL_CONTEXT_WINDOW=1000000

# 实际可用比例。默认 0.6，即 600K。
# 不设成 0.9 是因为：压缩本身要占一次调用、模型输出也占窗口、
# 而你只在发起调用前能控制（必须给这一轮还会加的量留余量）；
# 另外即使在窗口内，超长上下文的实际效果也会变差。
CONTEXT_BUDGET_RATIO=0.6

# 想直接指定绝对预算就填这个，填了它 CONTEXT_BUDGET_RATIO 不起作用。
# 演示时设成 500 之类的小值可以立刻看到压缩发生。
#CONTEXT_BUDGET_TOKENS=

# 压缩时原样保留最近几条消息
CONTEXT_KEEP_RECENT=6
